

MainScreen {
    ContentSwitcher {
        width: 1fr;
        height: 1fr;
    }
}

MainView {
    width: 100%;
    height: 100%;


    .upBar {
        width: 1fr;
        height: auto;
        padding: 1 2;
        align: center middle;

        Input {
            width: 60%;
        }

        Collapsible {
            width:20%;
        }

        #statsButton {
            width: 20%;
        }
    }

    .downBar {
        width: 1fr;
        height: auto;
        padding: 1 2;
        align: center middle;

        #addButton {
            width: 20%;
        }

        #quote {
            margin: 0 1;
            height: 100%;
            width: 60%;
            background: $surface;
            text-align: center;
        }

        #settingsButton {
            width: 20%;
        }
        dock:bottom;
    }

    .tableContainer {
        width: 100%;
        height: 1fr;
        align: center middle;

        DataTable {
            width: 100%;
            height: 100%;
            margin: 1 2;
            dock: left;
            border: solid $primary;
            background: $surface;

            & > .datatable--header {
                background: $primary;
                color: $text;
                text-style: bold;
            }

            & > .datatable--cursor {
                background: $accent;
                color: $text;
            }

            & :focus {
                background: $background;
            }
        }
    }
}